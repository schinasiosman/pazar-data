{
  "rules": {
    ".read": false,
    ".write": false,
    "lists": {
      "$code": {
        ".read": "$code.matches(/^[a-z2-9]{12}$/)",
        ".write": "$code.matches(/^[a-z2-9]{12}$/)",
        "rec": { ".validate": "newData.isString() && newData.val().length < 400000" },
        "updated": { ".validate": "newData.isNumber()" },
        "v": { ".validate": "newData.isNumber()" },
        "checked": { "$k": { ".validate": "newData.val() === true" } },
        "$other": { ".validate": false }
      }
    }
  }
}
